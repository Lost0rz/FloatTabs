        "Package.resolved",
        "tools/release/**"
      ],
      "runner": [
        "self-hosted",
        "macOS",
        "ARM64",
        "mac-mini-ci"
      ],
      "setup": [
        [
          "xcodebuild",
          "-project",
          "FloatTabs.xcodeproj",
          "-scheme",
          "FloatTabs",
          "-configuration",
          "Release",
          "-destination",
          "platform=macOS,arch=arm64",
          "CODE_SIGNING_ALLOWED=NO",
