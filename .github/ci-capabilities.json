        ]
      ],
      "command": [
        "xcodebuild",
        "-project",
        "FloatTabs.xcodeproj",
        "-scheme",
        "FloatTabs",
        "-configuration",
        "Debug",
        "-destination",
        "platform=macOS,arch=arm64",
        "CODE_SIGNING_ALLOWED=NO",
