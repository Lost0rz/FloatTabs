      "runner": [
        "self-hosted",
        "macOS",
        "ARM64",
        "mac-mini-ci"
      ],
      "command": [
        "xcodebuild",
        "-project",
        "FloatTabs.xcodeproj",
        "-scheme",
        "FloatTabs",
        "-configuration",
        "Debug",
        "-destination",
        "platform=macOS,arch=arm64",
        "CODE_SIGNING_ALLOWED=NO",
        "-only-testing:FloatTabsTests/WebViewPoolTests",
        "-only-testing:FloatTabsTests/WebViewFactoryTests",
        "-only-testing:FloatTabsTests/WebAttentionLifecycleTests",
        "-only-testing:FloatTabsTests/WebAttentionCrossFeatureTests",
